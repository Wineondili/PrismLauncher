+void tst_QAccessibility::tableStaleChildTest()
+{
+    // A platform plugin may delete a cell interface that QAccessibleTable
+    // still has cached (QTBUG-149612). Neither a model change nor a later
+    // child() lookup must crash or return null for a valid cell then.
+    auto tvHolder = std::make_unique<QTableWidget>(3, 3);
+    auto tableView = tvHolder.get();
+    for (int i = 0; i < 9; ++i)
+        tableView->setItem(i / 3, i % 3, new QTableWidgetItem(QString::number(i)));
+    tableView->resize(600, 600);
+    tableView->show();
+    QVERIFY(QTest::qWaitForWindowExposed(tableView));
+
+    QAccessibleInterface *iface = QAccessible::queryAccessibleInterface(tableView);
+    QVERIFY(iface);
+    QCOMPARE(iface->role(), QAccessible::Table);
+
+    // populate the child cache with two cells; with headers each row has 4 logical children
+    const int cellIndex = 1 * 4 + 2;
+    QAccessibleInterface *cell = iface->child(cellIndex);
+    QVERIFY(cell);
+    QCOMPARE(cell->role(), QAccessible::Cell);
+    QAccessibleInterface *otherCell = iface->child(2 * 4 + 3);
+    QVERIFY(otherCell);
+    const QAccessible::Id staleId = QAccessible::uniqueId(cell);
+
+    // simulate the platform layer deleting the interface behind the table's back
+    QAccessible::deleteAccessibleInterface(staleId);
+    QVERIFY(!QAccessible::accessibleInterface(staleId));
+
+    // a plain lookup must recreate the cell instead of handing out null
+    QAccessibleInterface *recreated = iface->child(cellIndex);
+    QVERIFY(recreated);
+    QCOMPARE(recreated->role(), QAccessible::Cell);
+    QVERIFY(QAccessible::uniqueId(recreated) != staleId);
+    QCOMPARE(iface->indexOfChild(recreated), cellIndex);
+
+    // same for the model change paths (RowsInserted / RowsRemoved)
+    QAccessible::deleteAccessibleInterface(QAccessible::uniqueId(recreated));
+    tableView->insertRow(0);
+    QVERIFY(iface->child(2 * 4 + 2));
+    QAccessible::deleteAccessibleInterface(QAccessible::uniqueId(iface->child(2 * 4 + 2)));
+    tableView->removeRow(0);
+    QVERIFY(iface->child(cellIndex));
+    QCOMPARE(iface->child(cellIndex)->text(QAccessible::Name), QString::number(1));
+    QVERIFY(otherCell->isValid());
+
+    QTestAccessibility::clearEvents();
+}
